# Production Environment Variables for tatakae-api
# Copy this file to .env and fill in the actual values

# Database credentials (required - no defaults in production)
DB_NAME=tatakae_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_password

# Apple Sign In with Apple authentication (required)
# Comma-separated list of Apple client IDs
# Known iOS audiences: com.aguilarjacob.tatakae, com.aguilarjacob.tatakae.dev
# Web Services ID to be added when Jacob confirms it
APPLE_CLIENT_IDS=com.aguilarjacob.tatakae,com.aguilarjacob.tatakae.dev
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# CORS allowed origins (required)
# Production: https://tatakae.fit (add https://www.tatakae.fit if www subdomain is configured)
CORS_ALLOWED_ORIGINS=https://tatakae.fit
